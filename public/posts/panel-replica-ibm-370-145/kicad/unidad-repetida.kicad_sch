	(wire (pts (xy 71.12 228.6) (xy 109.22 228.6)) (stroke (width 0) (type default)) (uuid "c6a0cdee-6da5-4e09-84c5-83ab31d80570"))
	(label "Q7_A_MISO" (at 109.22 228.6 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "1019e6ec-e725-48b6-94aa-b476663af608"))
	(text "10k fija el estado en reposo; 1k en serie protege el mazo largo (ESD / falla de cableado)." (at 20 278 0) (effects (font (size 1.8 1.8)) (justify left)) (uuid "6d4784a1-b995-498d-9f87-b699d31a4e85"))
	(text "CONEXION AL ARDUINO MEGA 2560" (at 288 22 0) (effects (font (size 2.5 2.5)) (justify left)) (uuid "0e2f12d3-f96c-498a-baf2-86b339855254"))
	(text "D51 MOSI   -> SER_IN de U1 (primer TPIC6B595)" (at 288 32.0 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "31c4fc95-7aea-4bb5-87be-e6255dfff8cd"))
	(text "D50 MISO   <- Q7 del primer 74HC165" (at 288 37.5 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "3d4d8b36-814f-4060-be1d-59a66b4ba6d9"))
	(text "D52 SCK    -> SRCK de todos los TPIC  Y  CP de todos los HC165  (bus compartido)" (at 288 43.0 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "eafccccd-eb8c-4f79-a403-4b5e1a5ca783"))
	(text "D53 SS     -> DEBE ser salida.  pinMode(53, OUTPUT) antes de SPI.begin()" (at 288 48.5 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "480ff4d3-1a31-49a7-9824-c8e121b02637"))
	(text "             Si queda como entrada y algo la baja, el SPI pasa a modo esclavo" (at 288 54.0 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "ccc7888b-0754-4487-8fc1-f984c8cafc8b"))
	(text "             en silencio y el panel se ensucia." (at 288 59.5 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "bfc507b5-e9fe-4c41-bdd9-9e7f2269767b"))
	(text "D8  LATCH  -> RCK de todos los TPIC   (flanco de subida, DESPUES de la trama)" (at 288 65.0 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "3d485199-2132-4c5f-8e4e-98584f6d577f"))
	(text "D9  LOAD   -> ~PL de todos los HC165  (pulso bajo, ANTES de la trama)" (at 288 70.5 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "797e2cf7-ba47-4c3b-84cc-99c5bcdd413a"))
	(text "" (at 288 76.0 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "8306cc27-ca25-47af-905d-5d842d0dc48b"))
	(text "Atados fijos:   ~G -> GND      ~SRCLR -> +5V      ~CE -> GND" (at 288 81.5 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "b7a53ddf-54ae-4e64-aa20-38d0e74666f2"))
	(text "                SER del ultimo HC165 -> GND" (at 288 87.0 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "067ea218-c34e-424b-a88d-1cba9a53665d"))
	(text "" (at 288 92.5 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "8279cf47-6406-4f1c-bb6e-eeb95016b3bd"))
	(text "ENLACE CON LA RASPBERRY PI 5 — opcion recomendada: UART directo, sin USB" (at 288 98.0 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "fe10f80a-27a2-4b25-8edc-e18d6c810b51"))
	(text "" (at 288 103.5 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "4ebfca19-540c-44a3-b82b-c69b46994025"))
	(text "   Mega D18 (TX, 5V) --[1k8]--+-- Pi GPIO15 (RXD, 3.3V)" (at 288 109.0 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "0a4bc3b4-9fde-438b-84d8-2f78e3b16449"))
	(text "                              |" (at 288 114.5 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "fdb710b0-6b93-4416-b154-c37a3e1c9162"))
