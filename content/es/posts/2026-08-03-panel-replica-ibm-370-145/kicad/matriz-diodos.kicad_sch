	(text "F" (at 316.23 22.86 0) (effects (font (size 2.0 2.0)) (justify left)) (uuid "eddd71b3-fb61-42d0-8c33-bffc9299aadb"))
	(text "POSICION (hex)" (at 46.99 22.86 0) (effects (font (size 2.0 2.0)) (justify left)) (uuid "5f60e89a-f3a4-4212-b4b6-9ba0f3bd59bd"))
	(text "MATRIZ DE DIODOS - UNA RUEDA" (at 17.78 167.64 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "ecf87347-888b-42a5-979d-94e4c05f4ffe"))
	(text "" (at 17.78 172.72 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "508c6903-e863-4f33-b2ba-a43faeaf0725"))
	(text "16 detentes -> 4 lineas binarias (b3..b0)" (at 17.78 176.53 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "22d0082d-4daf-4181-90d7-95df5421a020"))
	(text "mas 1 linea de validez (POS0)." (at 17.78 180.34 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "dc6be684-270f-4da1-bf8a-8de512b7b0ad"))
	(text "33 diodos por rueda · 264 para las ocho." (at 17.78 185.42 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "41b31733-5794-401f-98d8-907eb130c717"))
	(text "" (at 17.78 189.23 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "80fe6691-36ba-455e-bb1e-c43ea85c5b4d"))
	(text "COMO FUNCIONA" (at 17.78 193.04 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "e63f1906-77af-49ed-9199-146b055af4a3"))
	(text "  El polo comun va a masa.  Al elegir una" (at 17.78 196.85 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "7fc88a4a-c92b-4af8-bf2a-8e436a51d591"))
	(text "  posicion su terminal queda a masa y todos" (at 17.78 201.93 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "0c1ca8b2-ce35-4f32-8411-6aba15587305"))
	(text "  los diodos que cuelgan de el conducen," (at 17.78 205.74 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "ebfd71c1-2422-4061-9709-0e18ab449b42"))
	(text "  bajando sus rieles a ~0,7 V — por debajo" (at 17.78 209.55 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "34029b28-3c78-4f6b-8117-f56c3b581a0f"))
	(text "  del VIL de 1,5 V del 74HC a 5 V." (at 17.78 214.63 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "773154f4-1dac-4ad1-a11a-2441f79d5a2d"))
	(text "" (at 17.78 218.44 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "6d4547ef-37e3-45bd-9f01-1f13d3f2c887"))
	(text "  Los terminales no elegidos flotan y sus" (at 17.78 222.25 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "2f1b90b6-785a-4090-8c43-9e682535b855"))
	(text "  diodos quedan polarizados en inversa." (at 17.78 227.33 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "f908248b-6691-4560-bcba-2c1cc2902ef6"))
	(text "" (at 17.78 231.14 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "6fd49c37-5824-46c8-9335-e78d8ded24d7"))
	(text "  Se monta diodo donde el bit vale 1.  Como" (at 17.78 234.95 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "c29b9206-a951-434b-b7b5-ef3e01792b62"))
	(text "  el diodo BAJA la linea, el codigo leido es" (at 17.78 240.03 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "f25f3792-dbd9-40cb-8362-86ec1693e24c"))
	(text "  el COMPLEMENTO del valor:" (at 17.78 243.84 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "8dc26a00-3eda-4696-a15c-de99032b17fd"))
	(text "" (at 17.78 247.65 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "8c8baeb6-a972-4f51-9084-73cb16358902"))
	(text "        val = (~leido) & 0x0F" (at 17.78 251.46 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "5e23e9fe-e15b-4bad-8fd8-959caa49f694"))
	(text "" (at 17.78 256.54 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "d36a8751-4a17-4c48-9a57-7f24e4836137"))
	(text "NOTAS DE DIBUJO" (at 17.78 260.35 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "90d20a7a-5286-4b92-8eb2-160e01366262"))
	(text "  Los cruces sin punto de union NO conectan." (at 17.78 264.16 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "ae9096c2-9faf-45c8-8037-d8c5708467ab"))
	(text "  Pull-up 10k por riel." (at 17.78 269.24 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "d3dc143e-92d2-4729-858b-93ee8c81f025"))
	(text "  1k en serie protege el mazo largo." (at 17.78 273.05 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "7c2bd66b-f666-4ff1-b01b-2ce3bc1e739f"))
	(text "POR QUE LA LINEA POS0 NO ES OPCIONAL" (at 218.44 167.64 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "08d449c8-fba9-4e49-92a5-60c2bcfcd92c"))
	(text "" (at 218.44 172.72 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "610ed1dc-4d63-4d9b-9baa-ae9530d973b3"))
	(text "  Las rotativas son break-before-make:" (at 218.44 176.53 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "2a4d8b82-8092-49fa-a811-66f3afd663fc"))
	(text "  mientras se gira, entre un detente y el" (at 218.44 180.34 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "4900472c-71c1-4b2d-814d-bd6f6e2af2ac"))
	(text "  siguiente NINGUN terminal esta conectado" (at 218.44 185.42 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "57a2312f-d0bc-46cc-b200-c2a75dbf9f25"))
	(text "  y las cuatro lineas flotan altas." (at 218.44 189.23 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "90952966-d59b-426f-9565-290d681d55ca"))
	(text "" (at 218.44 193.04 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "7e9bbc78-560c-4a5b-b3b5-3521443df33b"))
	(text "  Eso se lee igual que una posicion 0" (at 218.44 196.85 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "ab0b1c0c-6aa2-4606-99b8-d00962a798dd"))
	(text "  legitima.  Con POS0 se distinguen:" (at 218.44 201.93 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "94aeaaca-3d09-47f3-9b04-e7bcfa8a5e47"))
	(text "" (at 218.44 205.74 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "712b8682-7a9b-4d25-a75f-4d34c7479e80"))
	(text "   algun bit bajo + POS0 alto" (at 218.44 209.55 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "d63d8fc1-4554-430b-be27-77e9664a21d4"))
	(text "        -> posiciones 1..F, leer el codigo" (at 218.44 214.63 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "073ada53-4c56-4487-8377-1d20b9dcaf4f"))
	(text "" (at 218.44 218.44 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "2df34ead-ef5f-460e-bb96-81742485f4f2"))
	(text "   todas altas    + POS0 BAJO" (at 218.44 222.25 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "c28e43a5-700a-4ac6-9012-ed75d677f80f"))
	(text "        -> posicion 0 legitima" (at 218.44 227.33 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "3cdfeacd-e79d-478d-bf5d-db34d4262717"))
	(text "" (at 218.44 231.14 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "9c0937c0-08c4-4540-84ff-10c505f981e6"))
	(text "   todas altas    + POS0 alto" (at 218.44 234.95 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "d86c9f94-f124-4416-91ea-ee8c6b65a442"))
	(text "        -> ENTRE DETENTES: descartar y" (at 218.44 240.03 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "47763273-4a35-4028-a538-cc4dd0b3a165"))
	(text "           conservar el ultimo valor valido" (at 218.44 243.84 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "42b8effd-b25a-4e1b-a2d4-8ef702e669e8"))
	(text "" (at 218.44 247.65 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "d1797741-a1b1-4e09-bfef-9b8c9205c4c1"))
	(text "  Sin POS0 una rueda a medio girar informa" (at 218.44 251.46 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "96e88727-49cf-460f-bba0-1f0314ca87a1"))
	(text "  cero en silencio.  En las ruedas F G H," (at 218.44 256.54 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "86eca457-4927-49d3-b454-533fa8e499e9"))
	(text "  que son LOAD UNIT ADDRESS, eso significa" (at 218.44 260.35 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "6e1ff0c6-bae4-40d1-90e8-4957abf2ee09"))
	(text "  arrancar del dispositivo equivocado." (at 218.44 264.16 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "29bd96ee-7b45-4f89-a557-5155911886d8"))
	(text "" (at 218.44 269.24 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "4bd9d103-63dc-4407-9dca-7f916d820507"))
	(text "  Cuesta 1 diodo y 1 linea por rueda." (at 218.44 273.05 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "5139a310-706b-4f2f-88fc-ad20abb3d674"))
